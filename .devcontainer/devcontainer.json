{
    "build": {
        "dockerfile": "Dockerfile"
    },

    "updateContentCommand": "npm install",
    "postAttachCommand": "npm start",

    "remoteUser": "node",

    "forwardPorts": [3000],

    // more settings for ports in containers.dev

    "portsAttributes": {
        "3000": {
            "label": "React App",
            "onAutoForward": "openPreview"
        }
    }
}