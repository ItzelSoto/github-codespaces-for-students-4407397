{
  "build": {
    "dockerfile": "Dockerfile"
  },

  "postCreateCommand": "curl -s https://packagecloud.io/install/repositories/github/git-lfs/script.deb.sh | sudo bash && sudo apt-get install git-lfs -y && git lfs install",
  "updateContentCommand": "npm install",
  "postAttachCommand": "npm start",

  "remoteUser": "node",

  "forwardPorts": [3000],

  // more settings for ports in containers.dev
  "portsAttributes": {
    "3000": {
      "label": "React.js",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"]
    }
  }
}
